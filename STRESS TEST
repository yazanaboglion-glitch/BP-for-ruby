require 'time'

# ==========================================
# מנוע הליבה (Interleaver)
# ==========================================
def run_bprogram(bthreads, actuate, steps = 1)
  syncs = {}

  bthreads.each do |bt|
    res = bt.resume rescue nil
    syncs[bt] = res if res
  end

  steps.times do
    requests = syncs.values.map { |s| s[:request] }.flatten.compact
    blocks   = syncs.values.map { |s| s[:block] }.flatten.compact

    allowed = requests.reject { |r| blocks.include?(r) }
    break if allowed.empty?

    chosen = allowed[rand(allowed.length)]
    actuate.call(chosen)

    syncs.keys.each do |bt|
      sync = syncs[bt]
      if chosen == sync[:request] or chosen == sync[:wait] or sync[:wait] == "***"
        res = bt.resume(chosen) rescue nil
        if res
          syncs[bt] = res
        else
          syncs.delete(bt)
        end
      end
    end
  end
end

# ==========================================
# מחולל התהליכים - מגריל מתוך 1,000 אירועים קבועים (E-000 עד E-999)
# ==========================================
def create_random_fiber()
  Fiber.new do
    num_requests = rand(1..5)
    num_blocks = rand(1..5)
    
    requests = Array.new(num_requests) { format("E-%03d", rand(0..999)) }
    blocks = Array.new(num_blocks) { format("E-%03d", rand(0..999)) }
    
    Fiber.yield({ request: requests, block: blocks })
  end
end

# ==========================================
# פונקציית מבחן העומס
# ==========================================
def run_stress_test_phase(number_of_bthreads)
  puts "--- מכין סביבה ל-#{number_of_bthreads} תהליכים (B-Threads) ---"
  
  bthreads = []
  number_of_bthreads.times do
    bthreads << create_random_fiber()
  end
  
  dummy_actuate = ->(event) { } 
  start_time = Time.now
  
  begin
    run_bprogram(bthreads, dummy_actuate, 1) 
    
    end_time = Time.now
    execution_time = end_time - start_time
    return execution_time

  rescue => e
    puts "שגיאה במהלך הריצה: #{e.message}"
    return -1
  end
end

# ==========================================
# התוכנית הראשית - הרצת 10, 100, 1000
# ==========================================
puts "מתחיל סדרת מבחני עומס חישובי (Stress Test)"
puts "=========================================="

phases = [10, 100, 1000]

phases.each do |load|
  total_time = 0.0
  runs = 30 
  
  runs.times do |run_idx|
    run_time = run_stress_test_phase(load)
    total_time += run_time if run_time != -1
  end
  
  avg_time = total_time / runs
  puts "[תוצאה סופית] בפעימה של #{load} תהליכים: זמן ממוצע #{avg_time.round(5)} שניות (מתוך #{runs} הרצות).\n\n"
end

puts "הניסוי הושלם."
